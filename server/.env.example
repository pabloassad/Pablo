# Port the service listens on (Railway/Render inject their own PORT).
PORT=4000

# Comma-separated allowlist of frontend origins allowed to call the API.
# Use "*" for local dev; set the deployed site origin in production.
CORS_ORIGIN=http://localhost:3000

# Hard timeout (ms) for a single extraction+transcode before returning 504.
CONVERT_TIMEOUT_MS=120000
